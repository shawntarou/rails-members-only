<h1><%= @post.title %></h1>

<% if user_signed_in? %>
  <span>Author: <%= @post.user.username %></span>
<% end %>
<div class="min-h-80">
  <p> <%= @post.body %> </p>
</div>

<div class="flex justify-between">
  <% if user_signed_in? %>
    <div class="flex gap-10">
      <%= link_to "Edit Post", edit_post_path(@post), class: "btn" %>
      <%= button_to "Delete Post", @post, method: :delete,
        data: { turbo_confirm: "Are you sure?" }, class: "btn" %>
    </div>
  <% else %>
    <div class="flex gap-10 invisible">
      <%= link_to "Edit Post", edit_post_path(@post), class: "btn" %>
      <%= button_to "Delete Post", @post, method: :delete,
        data: { turbo_confirm: "Are you sure?" }, class: "btn" %>
    </div>
  <% end %>
  <div class="text-right">
    <%= link_to "Back to Posts", posts_path %>
  </div>
</div>
